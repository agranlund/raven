#----------------------------------------------
# rvga configuration file
#----------------------------------------------

dacscale = 256      # digital brightness scale, 256 = 1.0

[cirrus]
# mclk = $1c        # slow, usually bios default
# mclk = $1f        #
# mclk = $22        # fast, xfree86 default for GD5434

[et4000.w32]
interleave = 0      # enable memory interleaving for cards that support it


[modes.vga]

# Mode13h (320x200@70Hz) is sometimes rejected by modern monitors
# and VGA->HDMI adapters despite decades of ubiquity.
# Uncomment to use a custom ~60Hz derivative as fallback.

#- 320 200 8 $13 m 0 320 0 0 0 0 400 440 492 512 1 1
